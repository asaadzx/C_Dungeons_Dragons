# ---------------------------------------------------------------------------
# .gitignore
# Tells Git which files/folders should NOT be tracked in version control.
# These are generated automatically and should not be shared between members.
# ---------------------------------------------------------------------------

# Python bytecode / cache files (auto-generated when Python runs)
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (each member creates their own locally)
.venv/
venv/
env/

# The SQLite database file (regenerated by running seed.py)
*.db

# Flask instance folder
instance/

# OS / editor junk
.DS_Store
.env
*.log

# Node / ESLint
node_modules/
.eslintcache

# Local docs / notes (not part of the deployed app)
README.md
